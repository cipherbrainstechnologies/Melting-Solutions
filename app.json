        "FOREGROUND_SERVICE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBzdTXBkHpTLdooSBlbvq2SGmG3SIpIUz8"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Melting Solution",
