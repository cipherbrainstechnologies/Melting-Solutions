# Environment variables for Melting Solution
# Copy this file to `.env` and fill in values for your Firebase / Maps project.
# Do not commit real secrets. Client Firebase config is also in `src/common/FirebaseConfig.js`
# and `google-services.json` for the Android app.

# Firebase (web SDK used by Expo)
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_web_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Google Maps (also referenced in app.json android.config.googleMaps.apiKey)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Expo
EXPO_OWNER=
EXPO_PROJECT_ID=
