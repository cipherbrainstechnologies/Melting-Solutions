{
  "name": "melting-solution",
  "version": "1.0.0",
  "scripts": {
    "start": "SET NODE_OPTIONS=--openssl-legacy-provider && expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "SET NODE_OPTIONS=--openssl-legacy-provider && expo start --web",
    "build:web": "SET NODE_OPTIONS=--openssl-legacy-provider && expo-cli build:web --non-interactive",
    "build:web:unix": "NODE_OPTIONS=--openssl-legacy-provider expo-cli build:web --non-interactive",
    "start:web": "node server.js",
    "railway:start": "node server.js",
    "eject": "expo eject",
    "android-linux": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "4.0.0",
    "@react-native-masked-view/masked-view": "0.2.6",
    "@react-native-picker/picker": "2.2.1",
    "expo": "~44.0.0",
    "expo-asset": "~8.4.6",
    "expo-device": "~4.1.0",
    "expo-file-system": "~13.1.4",
    "expo-font": "~10.0.4",
    "expo-image-picker": "~12.0.1",
    "expo-location": "~14.0.1",
    "expo-notifications": "~0.14.0",
    "expo-sharing": "~10.1.0",
    "expo-splash-screen": "~0.14.1",
    "expo-status-bar": "~1.2.0",
    "expo-updates": "~0.11.7",
    "express": "^4.22.2",
    "firebase": "8.2.3",
    "moment": "^2.29.3",
    "native-base": "^3.4.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "react-native": "0.64.3",
    "react-native-actions-sheet": "^0.6.1",
    "react-native-confirmation-code-field": "^7.3.0",
    "react-native-gesture-handler": "~2.1.0",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-maps": "0.29.4",
    "react-native-modal-datetime-picker": "^13.1.2",
    "react-native-pager-view": "5.4.9",
